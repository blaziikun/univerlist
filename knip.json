{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.ts",
    "worker/*.ts",
    "tools/*.ts",
    "tests/**/*.ts",
    "extensions/**/*.{js,mjs}"
  ],
  "project": [
    "src/**/*.{ts,svelte}",
    "worker/**/*.ts",
    "tools/**/*.ts",
    "tests/**/*.ts"
  ],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  }
}
